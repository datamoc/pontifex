    "e2e:tooltips": "node e2e/tooltips.mjs",
    "e2e:levels": "node e2e/levels-nav.mjs",
    "e2e:scroll": "node e2e/scroll-transitions.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e && npm run e2e:music && npm run e2e:sfx && npm run e2e:ships && npm run e2e:tooltips && npm run e2e:levels && npm run e2e:scroll",
    "content": "tsx tools/build-content.ts",
